{
  "name": "automated-job-search-app",
  "version": "1.0.0",
  "description": "Automated Job Search Application with AI-powered analysis",
  "homepage": "https://harithasandamal.github.io/JobSearchApp-V2",
  "main": "index.js",
  "scripts": {
    "start": "cross-env PORT=3001 BROWSER=none react-scripts start",
    "start-default": "react-scripts start",
    "build": "react-scripts build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "test:optimized": "node development/tests/test_optimized_scraping.js test",
    "test:rollback": "node development/tests/test_optimized_scraping.js rollback",
    "test:update-urls": "node development/tests/test_optimized_scraping.js update-urls",
    "test:loading-bars": "node development/tests/test_enhanced_loading_bars.js",
    "test:loading-integration": "node development/tests/test_enhanced_loading_integration.js",
    "test:loading-verification": "node development/tests/test_final_enhanced_loading_verification.js",
    "urls:list": "node development/tests/manage_test_urls.js list",
    "urls:add": "node development/tests/manage_test_urls.js add",
    "urls:remove": "node development/tests/manage_test_urls.js remove",
    "urls:validate": "node development/tests/manage_test_urls.js validate",
    "urls:config": "node development/tests/manage_test_urls.js config"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "jspdf": "^3.0.1",
    "mammoth": "^1.9.1",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "openai": "^4.52.7",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^24.15.0",
    "puppeteer-core": "^24.15.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "puppeteer-extra-plugin-user-preferences": "^2.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "table": "^6.9.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "gh-pages": "^6.3.0"
  }
}
